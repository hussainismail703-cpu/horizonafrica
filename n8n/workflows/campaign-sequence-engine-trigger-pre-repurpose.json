            }
          ]
        }
      }
    },
    {
      "id": "c8d970f1-cbac-48d9-be68-0ca6d1942c35",
      "name": "Call Campaign Process API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        224,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://dashboard.horizonafrica.co.za/api/campaigns/process",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer REDACTED-APP-SECRET"
