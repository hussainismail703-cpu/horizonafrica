            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}"
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "id": "ffe47f17-7689-4e1c-8ffe-e4528cdd2df2",
      "name": "Log Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst ts = new Date().toISOString();\nconsole.log(`[${ts}] Campaign process: processed=${r.processed} sent=${r.sent} failed=${r.failed} advanced=${r.advanced}`);\nif (r.errors && r.errors.length > 0) {\n  console.log('Errors:', JSON.stringify(r.errors));\n}\nreturn [{ json: { ts, ...r } }];"
      }
    },
    {
      "id": "c5435355-cc46-42fc-9a6a-81513d9886cf",
      "name": "Sticky Note 6383683c",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        224,
        64
      ],
      "parameters": {
        "content": {
          "content": "## Campaign Sequence Engine Trigger\n\nCalls the Horizon Africa dashboard `/api/campaigns/process` endpoint every 15 minutes.\n\nThe endpoint processes all active campaigns, sends due WhatsApp template messages, and advances enrolments.\n\n**Update the URL** to point to the correct Vercel deployment.\n**Update the Authorization Bearer token** to match the `APP_SECRET` env var set on the dashboard.",
          "position": [
            0,
            -120
          ]
        }
      }
    }
  ],
  "description": "Scheduled workflow that calls the Horizon Africa dashboard /api/campaigns/process endpoint every 15 minutes to process active campaigns, send due WhatsApp template messages, and advance enrolments."
