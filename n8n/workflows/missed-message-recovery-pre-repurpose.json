      "id": "becd8d31-8d9c-4035-9fb6-ec8742677677",
      "name": "Build Webhook Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $json;\nconst payload = {\n  object: 'whatsapp_business_account',\n  entry: [{\n    id: '1613835747059073',\n    changes: [{\n      value: {\n        messaging_product: 'whatsapp',\n        metadata: {\n          display_phone_number: '27757774389',\n          phone_number_id: '1257101724147822'\n        },\n        contacts: [{\n          profile: { name: item.contact_name || 'Unknown' },\n          wa_id: item.phone_number\n        }],\n        messages: [{\n          from: item.phone_number,\n          id: item.message_id || ('recovery_' + item.id),\n          timestamp: Math.floor(new Date(item.timestamp).getTime() / 1000).toString(),\n          text: { body: item.incoming_message },\n          type: 'text'\n        }]\n      },\n      field: 'messages'\n    }]\n  }]\n};\nreturn { json: { payload: payload, recordId: item.id, phoneNumber: item.phone_number } };"
      }
    },
